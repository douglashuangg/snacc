# Copy this file to supabase/.env.local and replace the placeholders.
# Never commit supabase/.env.local.
RAKUTEN_APPLICATION_ID=your-rakuten-application-id
RAKUTEN_ACCESS_KEY=your-current-rakuten-access-key

# API/Backend (recommended for local importer): leave blank and allowlist your
# public IP on the Rakuten app. Do not set https://localhost — it causes
# "Authentication service error".
#
# Web Application only: set to an Allowed Website origin, e.g. https://example.com
RAKUTEN_ORIGIN=

# Only required when running without --dry-run.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
