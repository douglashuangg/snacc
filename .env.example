EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Google signup (Supabase Auth → Providers → Google):
# 1. Enable Google and paste Client ID + Secret from Google Cloud.
# 2. In Google Cloud, authorized redirect URI must be:
#    https://<project-ref>.supabase.co/auth/v1/callback
# 3. In Supabase Auth → URL Configuration → Redirect URLs, add:
#    snacc://**
#    exp://**
#    (Expo Go prints the exact redirectTo in the Metro console when you tap Google.)
